<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <PackageId>SvcSystems.UI.Terminal</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Terminal Control for Avalonia</Description>
    <PackageTags>Avalonia Terminal Control XTerm</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/SvcSystems.UI.Terminal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="PropertyGenerator.Avalonia" Version="1.3.1" PrivateAssets="all" />
    <ProjectReference Include="..\XTerm.NET\XTerm.NET.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SvcSystems.UI.Terminal.Tests" />
    <InternalsVisibleTo Include="SvcSystems.UI.Terminal.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\XTerm.NET\bin\$(Configuration)\net10.0\XTerm.NET.dll" Pack="true" PackagePath="lib\net10.0\XTerm.NET.dll" Visible="false" />
    <None Include="..\XTerm.NET\bin\$(Configuration)\net11.0\XTerm.NET.dll" Pack="true" PackagePath="lib\net11.0\XTerm.NET.dll" Visible="false" />
    <None Include="..\XTerm.NET\LICENSE" Pack="true" PackagePath="licenses\" TargetPath="XTerm.NET-LICENSE.txt" />
  </ItemGroup>

</Project>
